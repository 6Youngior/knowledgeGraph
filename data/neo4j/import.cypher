MERGE (s:Document {id: "src:zai-glm5"}) SET s += {`id`: "src:zai-glm5", `title`: "GLM-5: From Vibe Coding to Agentic Engineering", `url`: "https://z.ai/blog/glm-5", `publisher`: "Z.ai (智谱)", `published_at`: "2026-02-12", `event_at`: "2026-02-12", `source_type`: "official_blog", `retrieved_at`: "2026-11-06T22:33:01+08:00", `date_basis`: "official visible page header: 2026-02-12 · Research", `text`: "We are launching GLM-5, targeting complex systems engineering and long-horizon agentic tasks. Scaling is still one of the most important ways to improve the intelligence efficiency of Artificial General Intelligence (AGI). Compared to GLM-4.5, GLM-5 scales from 355B parameters (32B active) to 744B parameters (40B active), and increases pre-training data from 23T to 28.5T tokens. GLM-5 also integrates DeepSeek Sparse Attention (DSA), significantly reducing deployment cost while preserving long-context capacity. …… GLM-4.5 is our first step for reasoning, coding, and agent, enabling the model to complete complex tasks. With GLM-5, we further enhance complex systems engineering and long-horizon agent capabilities. …… To this end, we developed slime, a novel asynchronous RL infrastructure that substantially improves training throughput and efficiency, enabling more fine-grained post-training iterations. …… GLM-5 is open-sourced on Hugging Face and ModelScope, with model weights released under the MIT License. GLM-5 is also available on developer platform api.z.ai and BigModel.cn, with compatibility with Claude Code and OpenClaw."};
MERGE (s:Document {id: "src:bigmodel-glm5"}) SET s += {`id`: "src:bigmodel-glm5", `title`: "GLM-5 - 智谱AI开放文档", `url`: "https://docs.bigmodel.cn/cn/guide/models/text/glm-5", `publisher`: "智谱 BigModel", `published_at`: "", `event_at`: "", `source_type`: "official_docs", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "GLM-5 是智谱的基座模型，面向 Agentic Engineering 打造，能够在复杂系统工程与长程 Agent 任务中提供可靠生产力。…… 参数规模扩展：从 355B（激活 32B）扩展至 744B（激活 40B），预训练数据从 23T 提升至 28.5T。…… 在 SWE-bench-Verified 和 Terminal Bench 2.0 中分别获得 77.8 和 56.2 的开源模型最高分数，性能表现超过 Gemini 3.0 Pro。"};
MERGE (s:Document {id: "src:github-glm5"}) SET s += {`id`: "src:github-glm5", `title`: "zai-org/GLM-5: GLM-5: From Vibe Coding to Agentic Engineering", `url`: "https://github.com/zai-org/GLM-5", `publisher`: "GitHub / Z.ai", `published_at`: "", `event_at`: "", `source_type`: "code_repository", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "GLM-5: From Vibe Coding to Agentic Engineering. Repository metadata: GitHub repository created 2026-02-09T08:17:02Z; Hugging Face model repository zai-org/GLM-5 created 2026-02-11T04:55:46Z. These timestamps are repository metadata, not a verified announcement time."};
MERGE (s:Document {id: "src:mthreads-glm5"}) SET s += {`id`: "src:mthreads-glm5", `title`: "Day-0 支持｜摩尔线程 MTT S5000 率先完成对 GLM-5 的适配", `url`: "https://www.mthreads.com/news/280", `publisher`: "摩尔线程", `published_at`: "2026-02-12", `event_at`: "2026-02-12", `source_type`: "official_news", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "2月12日，智谱正式发布新一代大模型GLM-5。摩尔线程基于SGLang推理框架，在旗舰级AI训推一体全功能GPU MTT S5000上，Day-0完成了全流程适配与验证。…… MTT S5000是专为大模型训练、推理及高性能计算而设计的全功能GPU智算卡，基于第四代MUSA架构“平湖”打造。…… MUSA软件栈的敏捷性是实现Day-0适配的关键。基于MUSA架构的TileLang原生算子单元测试覆盖率已超过80%，使得绝大多数通用算子可直接复用，显著降低移植成本，并能快速跟进前沿模型结构与新特性演进。"};
MERGE (s:Document {id: "src:mthreads-minimax"}) SET s += {`id`: "src:mthreads-minimax", `title`: "Day-0 支持｜摩尔线程完成 MiniMax M2.5 模型极速适配", `url`: "https://www.mthreads.com/news/281", `publisher`: "摩尔线程", `published_at`: "2026-02-14", `event_at`: "2026-02-14", `source_type`: "official_news", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "2月14日，摩尔线程在其旗舰级AI训推一体全功能GPU MTT S5000上，成功实现了对MiniMax新一代大模型MiniMax M2.5的Day-0极速适配。在此次适配工作中，摩尔线程技术团队依托MUSA软件栈强大的生态兼容性，基于高性能SGLang-MUSA推理引擎进行调优，成功在MTT S5000上实现了该模型的高性能推理。"};
MERGE (s:Document {id: "src:minimax-m25"}) SET s += {`id`: "src:minimax-m25", `title`: "MiniMax M2.5: Built for Real-World Productivity.", `url`: "https://www.minimax.io/news/minimax-m25", `publisher`: "MiniMax", `published_at`: "2026-02-12", `event_at`: "2026-02-12", `source_type`: "official_news", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "Today we're introducing our latest model, MiniMax-M2.5. Extensively trained with reinforcement learning in hundreds of thousands of complex real-world environments, M2.5 is SOTA in coding, agentic tool use and search, office work, and a range of other economically valuable tasks, boasting scores of 80.2% in SWE-Bench Verified, 51.3% in Multi-SWE-Bench, and 76.3% in BrowseComp."};
MERGE (s:Document {id: "src:minimax-m25-cn"}) SET s += {`id`: "src:minimax-m25-cn", `title`: "MiniMax M2.5: 更快更强更智能，为真实世界生产力而生", `url`: "https://www.minimax.cn/news/minimax-m25", `publisher`: "MiniMax", `published_at`: "2026-02-12", `event_at`: "2026-02-12", `source_type`: "official_news", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "今天我们来介绍 MiniMax-M2.5。经过数十万个真实复杂环境中的大规模强化学习训练，M2.5 在编程、工具调用和搜索、办公等生产力场景都达到或者刷新了行业的 SOTA。M2.5 优化了模型对复杂任务的拆解能力和思考过程中 token 的消耗，使其能更快地完成复杂的 Agentic 任务，比如在 SWE-Bench Verified 的测试中，比上一个版本 M2.1 完成任务的速度快了 37%。M2.5 已经在 MiniMax Agent 中全面上线，带来最佳 Agentic 体验。"};
MERGE (s:Document {id: "src:chinadaily-zhipu-ipo"}) SET s += {`id`: "src:chinadaily-zhipu-ipo", `title`: "“全球大模型第一股”来了！智谱港交所敲钟", `url`: "https://cn.chinadaily.com.cn/a/202601/08/WS695f5b9da310942cc499a93e.html", `publisher`: "中国日报网", `published_at`: "2026-01-08", `event_at`: "2026-01-08", `source_type`: "news", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "2026年1月8日，北京智谱华章科技股份有限公司（02513.HK）正式在香港联合交易所挂牌上市。…… 智谱首日开盘价120港元/股，盘中冲高，截至发稿最高触及130港元，较其发行价116.2港元上涨约12%，市值超570亿港元。…… 以每股116.20港元的发行价计算，智谱本次IPO募资总额超43亿港元。…… 2025年12月，智谱新一代基座模型GLM-4.7在模型综合能力榜单Artificial Analysis与权威编码榜单Code Arena中，均荣登开源模型与国产模型双料榜首。…… 智谱2019年由清华大学技术成果转化而来，专注通用人工智能（AGI）的研发，并坚持做让用户真正用得上的研究与技术。…… 其中编程订阅产品表现尤为突出，上线短时间内即实现过亿的年度经常性收入，并在海外开发者社群中快速渗透。"};
MERGE (s:Document {id: "src:hkex-zhipu-prospectus"}) SET s += {`id`: "src:hkex-zhipu-prospectus", `title`: "北京智譜華章科技股份有限公司 全球發售", `url`: "https://www1.hkexnews.hk/listedco/listconews/sehk/2025/1230/2025123000018_c.pdf", `publisher`: "香港交易所披露易", `published_at`: "2025-12-30", `event_at`: "2026-01-08", `source_type`: "prospectus", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "全球發售"};
MERGE (s:Document {id: "src:sse-mthreads-ipo"}) SET s += {`id`: "src:sse-mthreads-ipo", `title`: "关于摩尔线程智能科技（北京）股份有限公司人民币普通股股票科创板上市交易的公告", `url`: "https://www.sse.com.cn/disclosure/announcement/listing/ipo/c/c_20251204_10800678.shtml", `publisher`: "上海证券交易所", `published_at`: "2025-12-04", `event_at`: "2025-12-05", `source_type`: "exchange_announcement", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "上证公告（股票）[2025]35号 摩尔线程智能科技（北京）股份有限公司A股股票将在本所科创板上市交易。该公司A股股本为47002.8217万股，其中2938.2386万股于2025年12月5日起上市交易。证券简称为“摩尔线程”，证券代码为“688795”。"};
MERGE (s:Document {id: "src:mthreads-ipo-news"}) SET s += {`id`: "src:mthreads-ipo-news", `title`: "股票代码 688795！摩尔线程正式挂牌科创板！", `url`: "https://www.mthreads.com/news/266", `publisher`: "摩尔线程", `published_at`: "2025-12-05", `event_at`: "2025-12-05", `source_type`: "official_news", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "2025年12月5日，摩尔线程智能科技（北京）股份有限公司（简称：摩尔线程，股票代码：688795.SH）正式在上海证券交易所科创板挂牌上市，成为中国首家登陆资本市场的全功能GPU企业。"};
MERGE (s:Document {id: "src:alibaba-hkex-listing"}) SET s += {`id`: "src:alibaba-hkex-listing", `title`: "Alibaba Group Listed on Main Board of HKEX", `url`: "https://www.alibabagroup.com/en-US/document-1491198532105797632", `publisher`: "Alibaba Group", `published_at`: "2019-11-26", `event_at`: "2019-11-26", `source_type`: "company_press_release", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "Hong Kong, China, November 26, 2019 - Alibaba Group Holding Limited (\"Alibaba\" or the \"Company\") (NYSE: BABA and HKEX: 9988) has officially listed on the main board of the Hong Kong Exchanges and Clearing Limited (HKEX) today, successfully going public in Hong Kong."};
MERGE (s:Document {id: "src:acn-minimax-ipo"}) SET s += {`id`: "src:acn-minimax-ipo", `title`: "市值超800億 成功上市的MiniMax以「極致效率」重塑全球AGI新格局", `url`: "https://www.acnnewswire.com/press-release/traditionalchinese/104546/", `publisher`: "亚太商讯", `published_at`: "2026-01-09", `event_at`: "2026-01-09", `source_type`: "press_release", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "香港, 2026年1月9日 - (亞太商訊) - 1月9日，全球領先的通用人工智能科技公司——MiniMax（0100.HK）正式登陸港交所。"};
MERGE (s:Document {id: "src:aliyun-glm5"}) SET s += {`id`: "src:aliyun-glm5", `title`: "glm-5 模型信息 - 大模型服务平台百炼", `url`: "https://www.alibabacloud.com/help/zh/model-studio/glm-9", `publisher`: "阿里云", `published_at`: "", `event_at`: "", `source_type`: "official_docs", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "GLM-5是面向Coding与Agent场景的新一代大模型，在复杂系统工程与长程任务中达到开源 SOTA，真实编程体验逼近 Claude Opus 级别；基于 744B 新基座、异步强化学习与稀疏注意力，实现从“写代码”到“写工程”的全面升级。…… glm-5模型的推理服务供应商为阿里云百炼。"};
MERGE (s:Document {id: "src:aliyun-minimax"}) SET s += {`id`: "src:aliyun-minimax", `title`: "MiniMax-M2.5 模型信息 - 大模型服务平台百炼", `url`: "https://www.alibabacloud.com/help/zh/model-studio/minimax-m2-5", `publisher`: "阿里云", `published_at`: "", `event_at`: "", `source_type`: "official_docs", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "MiniMax-M2.5是MiniMax推出的旗舰级开源大模型，经过数十万个真实复杂环境中的大规模强化学习训练，M2.5 在编程、工具调用和搜索、办公等生产力场景都达到或者刷新了行业的 SOTA。…… MiniMax-M2.5模型的推理服务供应商为阿里云百炼。"};
MERGE (s:Document {id: "src:mthreads-s5000"}) SET s += {`id`: "src:mthreads-s5000", `title`: "MTT S5000 - 摩尔线程", `url`: "https://www.mthreads.com/product/S5000", `publisher`: "摩尔线程", `published_at`: "", `event_at`: "", `source_type`: "product_page", `retrieved_at`: "2026-11-06T22:33:01+08:00", `text`: "MTT S5000是专为大模型训练、推理及高性能计算而设计的全功能GPU智算卡，基于第四代MUSA架构“平湖”打造。完整支持从FP8到FP64的全精度计算。"};
MERGE (s:Document {id: "src:deepseek-r1-api"}) SET s += {`id`: "src:deepseek-r1-api", `title`: "DeepSeek-R1 Release - DeepSeek API Docs", `url`: "https://api-docs.deepseek.com/news/news250120/", `publisher`: "DeepSeek", `published_at`: "2025-01-20", `event_at`: "2025-01-20", `source_type`: "official_news", `retrieved_at`: "2026-11-07T00:00:00+08:00", `text`: "DeepSeek-R1 Release\nPerformance on par with OpenAI-o1\nFully open-source model & technical report\nCode and models are released under the MIT License: Distill & commercialize freely!\nWebsite & API are live now! Try DeepThink at chat.deepseek.com today!\nBonus: Open-Source Distilled Models!\nDistilled from DeepSeek-R1, 6 small models fully open-sourced"};
MERGE (s:Document {id: "src:qwen3-blog"}) SET s += {`id`: "src:qwen3-blog", `title`: "Qwen3: Think Deeper, Act Faster", `url`: "https://qwenlm.github.io/blog/qwen3/", `publisher`: "Qwen Team, Alibaba Cloud", `published_at`: "", `event_at`: "", `source_type`: "official_blog", `retrieved_at`: "2026-11-07T00:00:00+08:00", `text`: "Today, we are excited to announce the release of Qwen3, the latest addition to the Qwen family of large language models. Our flagship model, Qwen3-235B-A22B, achieves competitive results in benchmark evaluations of coding, math, general capabilities, etc., when compared to other top-tier models such as DeepSeek-R1, o1, o3-mini, Grok-3, and Gemini-2.5-Pro. …… We are open-weighting two MoE models: Qwen3-235B-A22B, a large model with 235 billion total parameters and 22 billion activated parameters, and Qwen3-30B-A3B, a smaller MoE model with 30 billion total parameters and 3 billion activated parameters. Additionally, six dense models are also open-weighted, including Qwen3-32B, Qwen3-14B, Qwen3-8B, Qwen3-4B, Qwen3-1.7B, and Qwen3-0.6B, under Apache 2.0 license. …… Feel free to try Qwen3 out in Qwen Chat Web (chat.qwen.ai) and mobile APP!"};
MERGE (s:Document {id: "src:qwen3-github"}) SET s += {`id`: "src:qwen3-github", `title`: "QwenLM/Qwen3: Qwen3 is the large language model series developed by Qwen team, Alibaba Cloud", `url`: "https://github.com/QwenLM/Qwen3", `publisher`: "Qwen Team, Alibaba Cloud", `published_at`: "", `event_at`: "", `source_type`: "code_repository", `retrieved_at`: "2026-11-07T00:00:00+08:00", `date_basis`: "Current GitHub About/README observed 2026-11-07; not a dated 2025-04-29 historical text", `text`: "Qwen3 is the large language model series developed by Qwen team, Alibaba Cloud. …… Visit our Hugging Face or ModelScope organization (click links above). …… 2025.04.29: We released the Qwen3 series. Check our blog for more details!"};
MERGE (s:Document {id: "src:mthreads-qwen3"}) SET s += {`id`: "src:mthreads-qwen3", `title`: "Day-0 支持｜摩尔线程 GPU 率先支持 Qwen3 全系列模型", `url`: "https://www.mthreads.com/news/241", `publisher`: "摩尔线程", `published_at`: "2025-04-29", `event_at`: "2025-04-29", `source_type`: "official_news", `retrieved_at`: "2026-11-07T00:00:00+08:00", `text`: "4月29日，阿里云正式发布Qwen3系列的8款开源混合推理模型。摩尔线程团队在模型发布当天，率先完成了Qwen3全系列模型在全功能GPU上的高效支持。…… Qwen3作为国内首个“混合推理模型”，创造性将“快思考”与“慢思考”集成进同一个模型，在推理、指令遵循、智能体功能和多语言支持方面取得了突破性的进步。"};
MERGE (s:Document {id: "src:hygon-adapt"}) SET s += {`id`: "src:hygon-adapt", `title`: "DeepSeek V3 和 R1 模型完成海光 DCU 国产化适配并正式上线", `url`: "https://www.ithome.com/0/828/487.htm", `publisher`: "IT之家", `published_at`: "2025-02-04", `event_at`: "2025-02-03", `source_type`: "news", `retrieved_at`: "2026-11-07T00:00:00+08:00", `text`: "IT之家 2 月 4 日消息，中科曙光国家先进计算产业创新中心有限公司昨日发文宣布，海光信息技术团队成功完成 DeepSeek V3 和 R1 模型与海光 DCU（深度计算单元）国产化适配，并正式上线。用户在“光合开发者社区”中的“光源”板块访问并下载相关模型，或登录光源官网搜索“DeepSeek”，即可基于 DCU 平台部署和使用相关模型。…… DCU 是海光信息推出的高性能 GPGPU 架构 AI 加速卡，致力于为行业客户提供自主可控的全精度通用 AI 加速计算解决方案。"};
MERGE (s:Document {id: "src:baidu-qianfan"}) SET s += {`id`: "src:baidu-qianfan", `title`: "百度智能云千帆全面支持DeepSeek-R1/V3调用，价格超低", `url`: "https://cloud.baidu.com/news/news_214c01fe-69f4-4e2e-8ca2-170aa44ad853", `publisher`: "百度智能云", `published_at`: "2025-02-05T10:10:04+08:00", `event_at`: "2025-02-03", `source_type`: "official_news", `retrieved_at`: "2026-11-07T00:00:00+08:00", `text`: "百度智能云千帆平台已正式上架 DeepSeek-R1和 DeepSeek-V3模型，推出了超低价格方案，还可享受限时免费服务，登录百度智能云千帆ModelBuilder即可快速体验。此次接入的模型已全面融合千帆推理链路，集成百度独家内容安全算子，实现模型安全增强与企业级高可用保障。…… 千帆平台具备卓越的模型推理托管能力，支持vLLM、LMDeploy、TensorRT-LLM、SGLang等各类主流推理框架。"};
MERGE (s:Document {id: "src:baidu-date"}) SET s += {`id`: "src:baidu-date", `title`: "百度智能云宣布上线DeepSeek-R1/V3模型", `url`: "https://www.bjnews.com.cn/detail/1738587281168005.html", `publisher`: "新京报", `published_at`: "2025-02-03", `event_at`: "2025-02-03", `source_type`: "news", `retrieved_at`: "2026-11-07T00:00:00+08:00", `text`: "新京报贝壳财经讯 2月3日，百度智能云宣布，DeepSeek-R1和DeepSeek-V3模型已在百度智能云千帆平台上架，并推出超低价格方案，同时提供限时2周免费服务。"};
MERGE (s:Document {id: "src:tencent-hai"}) SET s += {`id`: "src:tencent-hai", `title`: "高性能应用服务 HAI 快速使用 DeepSeek-R1 模型 - 腾讯云", `url`: "https://cloud.tencent.com/document/product/1721/115966", `publisher`: "腾讯云", `published_at`: "", `event_at`: "", `source_type`: "official_docs", `retrieved_at`: "2026-11-07T00:00:00+08:00", `text`: "本文介绍腾讯云HAI平台快速部署DeepSeek-R1模型的方法，支持通过OpenWebUI、AnythingLLM等可视化界面或命令行使用，并涵盖多参数量级切换。"};
MERGE (s:Document {id: "src:tencent-date"}) SET s += {`id`: "src:tencent-date", `title`: "DeepSeek-R1 大模型登陆腾讯云，宣称“一键部署、3 分钟调用”", `url`: "https://www.ithome.com/0/828/255.htm", `publisher`: "IT之家", `published_at`: "2025-02-02", `event_at`: "2025-02-02", `source_type`: "news", `retrieved_at`: "2026-11-07T00:00:00+08:00", `text`: "IT之家 2 月 2 日消息，深圳市腾讯计算机系统有限公司今日发文宣布，DeepSeek-R1 大模型支持一键部署至腾讯云「HAI」上，开发者 3 分钟就能接入调用。"};
MERGE (s:Document {id: "src:ctyun-r1"}) SET s += {`id`: "src:ctyun-r1", `title`: "DeepSeek-R1 模型在中国电信天翼云上架", `url`: "https://www.ithome.com/0/828/695.htm", `publisher`: "IT之家", `published_at`: "2025-02-05", `event_at`: "2025-02-05", `source_type`: "news", `retrieved_at`: "2026-11-07T00:00:00+08:00", `text`: "IT之家 2 月 5 日消息，中国电信今日宣布，天翼云成为国内最早支持 DeepSeek-R1 模型的云服务商之一，用户可在天翼云智算产品体系——息壤-科研助手、天翼 AI 云电脑、魔乐社区、“息壤”智算平台、GPU 云主机 / 裸金属开启智能新体验。"};
