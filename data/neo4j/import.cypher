MATCH (a:Entity {id: "model:glm47"}), (b:Entity {id: "company:zhipu"}) MERGE (a)-[r:DEVELOPED_BY {id: "rel:glm47-developed-by-zhipu"}]->(b) SET r += {`label`: "研发主体", `source_ids`: ["src:chinadaily-zhipu-ipo"], `evidence`: "2025年12月，智谱新一代基座模型GLM-4.7", `disclosed_at`: "2026-01-08", `relation_group`: "direct"};
