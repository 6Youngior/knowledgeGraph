MERGE (s:Document {id: "src:hkex-chinatelecom"}) SET s += {`id`: "src:hkex-chinatelecom", `title`: "China Telecom Corporation Limited - Company Profile and Corporate Information", `url`: "https://www1.hkexnews.hk/listedco/listconews/sehk/2003/0428/728/ewp104.pdf", `publisher`: "Hong Kong Exchanges and Clearing", `published_at`: "2003-04-28", `event_at`: "", `source_type`: "company_report", `retrieved_at`: "2026-11-07T00:00:00+08:00", `date_basis`: "HKEXnews archive path /2003/0428/", `text`: "H shares: The Stock Exchange of Hong Kong Limited stock code: 728 …… Our H shares and American Depositary Shares (\"ADS\") were listed on the Stock Exchange of Hong Kong and the New York Stock Exchange on 15 November 2002 and 14 November 2002 respectively."};
MERGE (s:Document {id: "src:sse-hygon"}) SET s += {`id`: "src:sse-hygon", `title`: "关于海光信息技术股份有限公司人民币普通股股票科创板上市交易的公告", `url`: "https://www.sse.com.cn/disclosure/announcement/listing/ipo/c/c_20220811_86447590.shtml", `publisher`: "上海证券交易所", `published_at`: "2022-08-11", `event_at`: "2022-08-12", `source_type`: "exchange_announcement", `retrieved_at`: "2026-11-07T00:00:00+08:00", `text`: "上证公告（股票）[2022]91号 海光信息技术股份有限公司A股股票将在本所科创板上市交易。该公司A股股本为232,433.8091万股，其中19,960.5793万股于2022年8月12日起上市交易。证券简称为“海光信息”，证券代码为“688041”。"};
MERGE (s:Document {id: "src:hygon-qwen3"}) SET s += {`id`: "src:hygon-qwen3", `title`: "Qwen3发布并开源，海光DCU实现全模型无缝适配", `url`: "https://www.21ic.com/a/986112.html", `publisher`: "21ic电子网", `published_at`: "2025-04-29", `event_at`: "2025-04-29", `source_type`: "news", `retrieved_at`: "2026-11-07T00:00:00+08:00", `text`: "2025年4月29日，阿里巴巴云旗下的Qwen团队正式发布并开源Qwen3，作为Qwen系列的最新一代大型语言模型（LLM），包含一系列密集型（Dense）和混合专家（MoE）模型，参数规模从0.6亿至2350亿不等。同日，海光信息技术股份有限公司（以下简称“海光信息”）在其“智能深算”战略引领下，宣布其深算单元（DCU，Deep Computing Unit）已完成对Qwen3全部8款模型（235B、32B、30B、14B、8B、4B、1.7B、0.6B）的无缝适配与优化，实现零错误、零兼容性问题、秒级部署。"};
MERGE (s:Document {id: "src:deepseek-r1-github"}) SET s += {`id`: "src:deepseek-r1-github", `title`: "deepseek-ai/DeepSeek-R1 - GitHub README", `url`: "https://github.com/deepseek-ai/DeepSeek-R1", `publisher`: "DeepSeek", `published_at`: "", `event_at`: "", `source_type`: "code_repository", `retrieved_at`: "2026-11-07T00:00:00+08:00", `date_basis`: "GitHub README observed at retrieval; no explicit publication date on the README", `text`: "We introduce our first-generation reasoning models, DeepSeek-R1-Zero and DeepSeek-R1. …… To support the research community, we have open-sourced DeepSeek-R1-Zero, DeepSeek-R1, and six dense models distilled from DeepSeek-R1 based on Llama and Qwen."};
MERGE (s:Document {id: "src:minimax-m21-github"}) SET s += {`id`: "src:minimax-m21-github", `title`: "MiniMax-AI/MiniMax-M2.1 - GitHub README", `url`: "https://github.com/MiniMax-AI/MiniMax-M2.1", `publisher`: "MiniMax", `published_at`: "", `event_at`: "", `source_type`: "code_repository", `retrieved_at`: "2026-11-07T00:00:00+08:00", `date_basis`: "GitHub README observed at retrieval; no explicit publication date on the README", `text`: "Today, we are handing MiniMax-M2.1 over to the open-source community. …… Your name is MiniMax-M2.1 and is built by MiniMax."};
MERGE (s:Document {id: "src:qwen3-alibaba-press"}) SET s += {`id`: "src:qwen3-alibaba-press", `title`: "阿里巴巴發佈Qwen3 混合推理模型樹立開源AI新標桿", `url`: "https://www.alibabagroup.com/zh-HK/document-1853940226976645120", `publisher`: "Alibaba Group", `published_at`: "2025-04-29", `event_at`: "2025-04-29", `source_type`: "press_release", `retrieved_at`: "2026-11-07T00:00:00+08:00", `date_basis`: "Alibaba Group document metadata documentPublishTimeLocal: 2025年4月29日", `text`: "阿里巴巴集團發佈開源大語言模型家族最新成員 Qwen3，為AI創新樹立新標桿。…… Qwen3全系列模型現已開源並全球上線，包含六款密集模型（參數量0.6B、1.7B、4B、8B、14B、32B）及兩款MoE模型（30B總參數、3B激活參數；235B總參數、22B激活參數）。"};
MERGE (s:Document {id: "src:qwen3-alibaba-cloud"}) SET s += {`id`: "src:qwen3-alibaba-cloud", `title`: "Alibaba Introduces Qwen3, Setting New Benchmark in Open-Source AI with Hybrid Reasoning", `url`: "https://www.alibabacloud.com/en/press-room/alibaba-introduces-qwen3-setting-new-benchmark", `publisher`: "Alibaba Cloud", `published_at`: "2025-04-29", `event_at`: "2025-04-29", `source_type`: "press_release", `retrieved_at`: "2026-11-07T00:00:00+08:00", `date_basis`: "Official press release date line: April 29, 2025", `text`: "Hangzhou, China, April 29, 2025 - Alibaba has launched Qwen3, the latest generation of its open-sourced large language model (LLM) family, setting a new benchmark for AI innovation. …… All Qwen3 models – including dense models (0.6B, 1.7B, 4B, 8B, 14B, and 32B parameters) and MoE models (30B with 3B active, and 235B with 22B active) – are now open sourced and available globally."};
MERGE (s:Document {id: "src:aliyun-bailian-product"}) SET s += {`id`: "src:aliyun-bailian-product", `title`: "大模型服务平台百炼 - 阿里云", `url`: "https://www.aliyun.com/product/bailian", `publisher`: "阿里云", `published_at`: "", `event_at`: "", `source_type`: "product_page", `retrieved_at`: "2026-11-07T00:00:00+08:00", `date_basis`: "Product page observed at retrieval; no explicit publication date", `text`: "大模型服务平台百炼 - 大模型应用构建 - 阿里云 …… 大模型服务平台百炼 …… 阿里云百炼"};
